+/*
+ * LINE_MAX is specified by POSIX to come from <limits.h>, but Bionic's
+ * limits.h does not define it.  Without this guard the build dies with
+ * "use of undeclared identifier 'LINE_MAX'" on every NDK older than r30.
+ * 2048 matches glibc and only sizes a pipe read buffer here.
+ */
+#ifndef LINE_MAX
+#define LINE_MAX 2048
+#endif
