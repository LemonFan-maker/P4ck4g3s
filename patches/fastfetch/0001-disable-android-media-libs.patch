diff --git a/src/detection/codec/codec_android_stub.c b/src/detection/codec/codec_android_stub.c
new file mode 100644
index 0000000..0e4cfc3
--- /dev/null
+++ b/src/detection/codec/codec_android_stub.c
@@ -0,0 +1,8 @@
+#include "codec.h"
+
+// Avoid libmediandk (and its private libmedia/libandroidicu dependency).
+const char* ffDetectCodecNative(FFCodecOptions* options, FFlist* result) {
+    (void) options;
+    (void) result;
+    return "Codec detection is disabled in this Android build";
+}
diff --git a/src/detection/media/media_android_stub.c b/src/detection/media/media_android_stub.c
new file mode 100644
index 0000000..00fc4ad
--- /dev/null
+++ b/src/detection/media/media_android_stub.c
@@ -0,0 +1,9 @@
+#include "media.h"
+
+// This Android build deliberately does not link the platform media stack.
+// libmediandk pulls in libmedia, which needs libandroidicu in a linker
+// namespace that is not available to ordinary app processes.
+void ffDetectMediaImpl(FFMediaResult* media, bool saveCover) {
+    (void) saveCover;
+    ffStrbufAppendS(&media->error, "Media detection is disabled in this Android build");
+}
